{
  "name": "getkit",
  "version": "0.6.0",
  "description": "HTTP base promised and callback and User agent",
  "main": "./dist/cjs/getkit-full.cjs.js",
  "module": "./dist/esm/src/main.js",
  "types": "./dist/ts/main.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/esm/src/main.js",
      "require": "./dist/cjs/getkit-full.cjs.js",
      "types": {
        "require": "./dist/ts/main.d.ts",
        "default": "./dist/ts/main.d.ts"
      },
      "browser": {
        "require": "./dist/cjs/getkit-full.cjs.js",
        "default": "./dist/cjs/getkit-full.cjs.js"
      },
      "default": {
        "require": "./dist/cjs/getkit-full.cjs.js",
        "default": "./dist/cjs/getkit-full.cjs.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/cjs",
    "dist/esm",
    "dist/ts"
  ],
  "scripts": {
    "es_linter": "eslint  src/*.js src/lib/*.js src/core/*.js --fix",
    "test_esm": "mocha test/library/cjs/*.test.js --timeout 4000 --exit",
    "test_cjs": "mocha test/cjs/*.test.js --timeout 1000 --exit",
    "validate": "npm run style && npm run test",
    "run_server": "node test/local/server.js"
  },
  "tsd": {
    "directory": "test/ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/compts/getkit.git"
  },
  "keywords": [
    "compt"
  ],
  "author": "Pein Freccs",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/compts/getkit/issues"
  },
  "homepage": "https://getkit.codehyouka.xyz",
  "dependencies": {
    "structkit": "^1.4.873",
    "url-assist": "^1.2.71"
  },
  "devDependencies": {
    "@types/node": "^20.5.9",
    "eslint": "^7.13.0",
    "eslint-config-strongloop": "^2.1.0",
    "esm": "^3.2.25",
    "jest": "^27.5.1",
    "mocha": "^5.2.0",
    "supertest": "^7.1.1",
    "typescript": "^5.7.2",
    "tsd": "^0.19.1"
  }
}
